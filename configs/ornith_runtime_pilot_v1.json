  "purpose": "Runtime, infrastructure, and validity pilot; score estimates are directional only.",
  "selection_seed": "cospa-ornith-runtime-pilot-v1",
  "selection_policy": {
    "outcome_blind": true,
    "repository_suites": "Allocate approximately 10% by language; preserve published task-type/difficulty proportions where available; balance patch-size tertiles and prefer distinct repositories using a stable SHA-256 tie-break.",
    "featurebench": "Six tasks from distinct repositories: five L1 and one L2, balanced across patch-size strata.",
    "bigcodebench": "Fifteen Instruct tasks proportional across 3/4/5+ library-count strata, balanced across prompt-size tertiles.",
    "terminal_bench": "Eight predeclared capability strata, including one deliberately heavy build task; no target-model outcomes inspected."
  },
  "runtime_policy": {
    "model": "shisa/ornith-35b-fp8-block",
    "adapter": "pi_vanilla",
    "thinking": "xhigh",
    "independent_trials": 1,
    "concurrency_ladder": [
      1,
      2,
      4,
      8,
      16
    ],
    "intended_production_concurrency": 16,
    "routine_wall_target_hours": 12,
    "reserve_fraction": 0.2,
    "campaign_budget_hours": 9.6,
    "crossover_gate": {
      "initial_concurrency": [
        1,
        2
      ],
      "advance_when": "c=2 increases completed tasks/hour by at least 10%, infrastructure failures remain <=5%, and failure semantics do not change.",
      "higher_concurrency": "Advance through 4, 8, and 16 one rung at a time; stop on throughput regression, p95 wall >2.5x the c=1 p95, endpoint overload, or host pressure."
    },
    "host_limits": {
      "logical_cpus_per_trial": 2,
      "memory_gib_per_trial_start": 8,
      "max_parallel_trials": 16,
      "minimum_available_memory_gib": 32,
      "note": "Increase per-task memory only for a recorded suite/image requirement; reduce concurrency to preserve the host reserve."
    },
    "required_telemetry": [
      "cold_setup_seconds",
      "warm_setup_seconds",
      "agent_wall_seconds",
      "provider_inference_seconds",
      "tool_wall_seconds",
      "verifier_seconds",
      "total_wall_seconds",
      "queue_time_if_exposed",
      "token_usage",
      "tool_names_types_counts_errors",
      "score",
      "failure_taxonomy"
    ],
    "failure_taxonomy": [
      "setup_failed",
      "image_failed",
      "model_transport_failed",
      "budget_exhausted",
      "verifier_failed",
      "incorrect",
      "resolved"
    ]
  },
